{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meadow",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/oauth/*", "/downloads/*", "/health"]
  },
  "containers": [
    {
      "class_name": "PodcastClipperBackend",
      "image": "./backend/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "PodcastClipperBackend"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PodcastClipperBackend"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PORT": "8787",
    "PYTHON_BIN": "python3",
    "WHISPER_MODEL": "base",
    "GEMINI_MODEL": "gemini-3.6-flash",
    "BRIDGE_APP_URL": "https://findmeadow.com",
    "BRIDGE_PUBLIC_URL": "https://findmeadow.com",
    "BRIDGE_MAX_UPLOAD_MB": "1024",
    "BRIDGE_CLIPPING_ENABLED": "true",
    "BRIDGE_PUBLISHING_ENABLED": "true"
  },
  "routes": [
    { "pattern": "findmeadow.com", "custom_domain": true },
    { "pattern": "www.findmeadow.com", "custom_domain": true }
  ]
}
