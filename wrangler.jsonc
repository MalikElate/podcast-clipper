{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podcast-clipper",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/dashboard", "/dashboard/*", "/runtime-config.js", "/sprout", "/sprout/*", "/api/*", "/media/*", "/oauth/*", "/mcp", "/.well-known/oauth-protected-resource", "/.well-known/oauth-protected-resource/*", "/health"]
  },
  "containers": [
    {
      "class_name": "PodcastClipperBackend",
      "image": "./backend/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-2",
      "authorized_keys": []
    }
  ],
  "ai": { "binding": "ROAST_AI" },
  "ratelimits": [
    { "name": "ROAST_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "FREE_TOOLS_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROAST_BUDGET", "class_name": "RoastBudget" },
      {
        "name": "BACKEND",
        "class_name": "PodcastClipperBackend"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PodcastClipperBackend"]
    },
    { "tag": "v2-roast-budget", "new_sqlite_classes": ["RoastBudget"] }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": { "crons": ["0 3 * * *", "*/30 * * * *"] },
  "r2_buckets": [{ "binding": "MEADOW_MEDIA", "bucket_name": "meadow-media" }],
  "vars": {
    "PORT": "8787",
    "BRIDGE_APP_URL": "https://app.findmeadow.com",
    "BRIDGE_PUBLIC_URL": "https://findmeadow.com",
    "CLERK_MCP_ISSUER": "https://clerk.findmeadow.com",
    "BRIDGE_MAX_UPLOAD_MB": "5115",
    "R2_UPLOAD_ACCOUNT_ID": "d136d22204e1849c0078839bc8f32a7f",
    "R2_UPLOAD_BUCKET": "meadow-media",
    "BRIDGE_PUBLISHING_ENABLED": "true",
    "BRIDGE_ADMIN_UIDS": "user_3JBc1sWWzPxfPBGc3WGz7bw0Slu",
    "FACEBOOK_LOGIN_CONFIG_ID": "1758250408777427",
    "TIKTOK_DIRECT_POST_PRIVATE_ONLY": "true",
    "ZERNIO_PLATFORMS": "tiktok,snapchat,facebook,instagram,threads,pinterest",
    "TELEGRAM_BOT_USERNAME": "FindMeadowAppBot"
  },
  "routes": [
    { "pattern": "findmeadow.com", "custom_domain": true },
    { "pattern": "www.findmeadow.com", "custom_domain": true },
    { "pattern": "app.findmeadow.com", "custom_domain": true }
  ]
}
