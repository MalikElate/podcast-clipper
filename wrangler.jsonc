{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podcast-clipper",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/dashboard", "/dashboard/*", "/api/*", "/media/*", "/oauth/*", "/health"]
  },
  "containers": [
    {
      "class_name": "PodcastClipperBackend",
      "image": "./backend/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "PodcastClipperBackend"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PodcastClipperBackend"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": { "crons": ["0 3 * * *"] },
  "r2_buckets": [{ "binding": "MEADOW_MEDIA", "bucket_name": "meadow-media" }],
  "vars": {
    "PORT": "8787",
    "BRIDGE_APP_URL": "https://app.findmeadow.com",
    "BRIDGE_PUBLIC_URL": "https://findmeadow.com",
    "BRIDGE_MAX_UPLOAD_MB": "1024",
    "BRIDGE_DISABLED_PLATFORMS": "facebook,instagram,threads",
    "BRIDGE_PUBLISHING_ENABLED": "true"
  },
  "routes": [
    { "pattern": "findmeadow.com", "custom_domain": true },
    { "pattern": "www.findmeadow.com", "custom_domain": true },
    { "pattern": "app.findmeadow.com", "custom_domain": true }
  ]
}
