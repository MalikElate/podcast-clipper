# Meadow server — all values in this file are private runtime configuration.
PORT=8787
HOST=127.0.0.1
BRIDGE_APP_URL=http://localhost:5173
BRIDGE_PUBLIC_URL=http://localhost:8787
# Defaults to backend/.bridge. Use a persistent volume in production.
# BRIDGE_DATA_DIR=/absolute/path/to/bridge-data
# Generate two separate strong random secrets; encryption must decode to 32 bytes.
BRIDGE_ENCRYPTION_KEY=
BRIDGE_MEDIA_SIGNING_KEY=
BRIDGE_MAX_UPLOAD_MB=1024
BRIDGE_CLIPPING_ENABLED=true
BRIDGE_PUBLISHING_ENABLED=true
BRIDGE_DISABLED_PLATFORMS=
BRIDGE_SERVE_FRONTEND=false
# Affiliate program. Generate a strong private secret for billing webhooks.
BRIDGE_AFFILIATE_SECRET=
BRIDGE_AFFILIATE_COMMISSION_BPS=2000
BRIDGE_AFFILIATE_ATTRIBUTION_DAYS=30
# Number of trusted reverse-proxy hops, only when deployed behind that proxy.
# BRIDGE_TRUST_PROXY=1
# Explicit development preview only. Never enable in a production build/server.
# BRIDGE_LOCAL_PREVIEW=1

# Firebase Admin: use one option, supplied privately. Never put Admin secrets in VITE_*.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/private/path/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Native publishing applications. Register each callback as:
# <BRIDGE_PUBLIC_URL>/oauth/<platform-id>/callback
# See docs/platforms.md for scopes, eligibility, audits, and account selection.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
META_GRAPH_VERSION=v24.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202607
LINKEDIN_SCOPES=openid profile w_member_social
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Shared Google OAuth app; optional per-platform overrides below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# GOOGLE_BUSINESS_CLIENT_ID=
# GOOGLE_BUSINESS_CLIENT_SECRET=
# ES256 PKCS#8 private PEM (multiline secret or literal \n characters).
# Bluesky uses OAuth with public metadata and JWKS; no app passwords.
BLUESKY_PRIVATE_KEY=

# Clipping: one RapidAPI key subscribed to BOTH downloader listings.
RAPIDAPI_KEY=
# VIDEO_RAPIDAPI_HOST=cloud-api-hub-youtube-downloader.p.rapidapi.com
# AUDIO_RAPIDAPI_HOST=youtube-mp36.p.rapidapi.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
WHISPER_MODEL=base
PYTHON_BIN=python3
# Timeouts in milliseconds.
# RAPIDAPI_TIMEOUT_MS=30000
# DOWNLOAD_INACTIVITY_TIMEOUT_MS=45000
# DOWNLOAD_TOTAL_TIMEOUT_MS=1800000
# FFMPEG_TIMEOUT_MS=1800000
# METADATA_TIMEOUT_MS=15000
# WHISPER_TIMEOUT_MS=7200000
