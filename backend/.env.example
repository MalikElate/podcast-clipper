# --- YouTube downloading (two RapidAPI providers, merged with ffmpeg) ---
# One RapidAPI account/key, subscribed (free tiers are fine) to both:
#   - "Cloud API Hub - YouTube Downloader"  -> gives the video-only stream
#   - "YouTube MP3"                          -> gives the audio track
RAPIDAPI_KEY=your_rapidapi_key_here
# Optional overrides if you point at different RapidAPI listings for these:
# VIDEO_RAPIDAPI_HOST=cloud-api-hub-youtube-downloader.p.rapidapi.com
# AUDIO_RAPIDAPI_HOST=youtube-mp36.p.rapidapi.com
# Optional timeout overrides (milliseconds):
# RAPIDAPI_TIMEOUT_MS=30000
# DOWNLOAD_INACTIVITY_TIMEOUT_MS=45000
# DOWNLOAD_TOTAL_TIMEOUT_MS=1800000
# FFMPEG_TIMEOUT_MS=1800000
# METADATA_TIMEOUT_MS=15000

# Gemini is now only used to pick which moments become clips (not transcription).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
PORT=8787

# --- Clerk (backend authentication) ---
# Keep the secret key server-side. It must never use a VITE_ prefix.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# --- Transcription (Whisper, runs locally via Python) ---
# tiny/base/small/medium/large. base is a good CPU speed/accuracy default.
WHISPER_MODEL=base
# Only needed if your Python 3 binary isn't named "python3" on PATH (e.g. "python" on Windows).
PYTHON_BIN=python3
