# Meadow server — all values in this file are private runtime configuration.
PORT=8787
HOST=127.0.0.1
BRIDGE_APP_URL=http://localhost:5173
BRIDGE_PUBLIC_URL=http://localhost:8787
# Defaults to backend/.bridge. Self-hosting requires a persistent local volume.
# On Cloudflare this directory holds the restored database and media cache.
# BRIDGE_DATA_DIR=/absolute/path/to/bridge-data
# Cloudflare sets this automatically for its private Durable Object/R2 bridge.
# Leave unset for local development and ordinary self-hosting. An initialized
# durable snapshot is required; do not connect a second active backend writer.
# BRIDGE_DURABLE_STORAGE_URL=http://meadow.storage
# Generate two separate strong random secrets; encryption must decode to 32 bytes.
# Preserve these keys across restarts, deployments, and durable-state recovery.
BRIDGE_ENCRYPTION_KEY=
BRIDGE_MEDIA_SIGNING_KEY=
BRIDGE_MAX_UPLOAD_MB=1024
# Disabling publishing does not disable connection renewal or privacy maintenance.
BRIDGE_PUBLISHING_ENABLED=true
BRIDGE_DISABLED_PLATFORMS=
BRIDGE_SERVE_FRONTEND=false
# Number of trusted reverse-proxy hops, only when deployed behind that proxy.
# BRIDGE_TRUST_PROXY=1
# Explicit development preview only. Never enable in a production build/server.
# BRIDGE_LOCAL_PREVIEW=1

# Clerk authentication. Keep the secret key server-side.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Register user.deleted at <BRIDGE_PUBLIC_URL>/api/clerk/webhook.
CLERK_WEBHOOK_SIGNING_SECRET=

# Legacy PostHog deletion. Product analytics collection is now disabled.
# Set false ONLY for a deployment that has never collected identified PostHog data.
BRIDGE_POSTHOG_LEGACY_DATA=true
POSTHOG_PROJECT_ID=
# A server-side personal key with person:read and person:write, never a VITE value.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=https://us.posthog.com

# Stripe subscriptions. Create matching monthly/yearly recurring Prices, then
# register <BRIDGE_PUBLIC_URL>/api/stripe/webhook for Checkout and subscription events.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Trybe Universal Pixel / Orders API credentials (not the read-only tk_live_ key).
TRYBE_ORDERS_API_KEY=
TRYBE_STORE_ID=

# Native publishing applications. Register each callback as:
# <BRIDGE_PUBLIC_URL>/oauth/<platform-id>/callback
# See docs/platforms.md for scopes, eligibility, audits, and account selection.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
# Optional versioned replacements. The Cloudflare Worker prefers these when
# present so the original Meta credentials can remain available for rollback.
INSTAGRAM_CLIENT_ID_V2=
INSTAGRAM_CLIENT_SECRET_V2=
FACEBOOK_CLIENT_ID_V2=
FACEBOOK_CLIENT_SECRET_V2=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
META_GRAPH_VERSION=v24.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Restrict Direct Post to Only me until TikTok's Direct Post audit is approved.
# Set false only after approval; inbox uploads are unaffected.
TIKTOK_DIRECT_POST_PRIVATE_ONLY=true
# Zernio publishes for platforms awaiting Meadow's own app approval. With a key set,
# new connections for ZERNIO_PLATFORMS go through Zernio (default: all six below);
# accounts connected natively before the switch keep working. Remove a platform
# from the list once its native app is approved.
ZERNIO_API_KEY=
ZERNIO_PLATFORMS=tiktok,snapchat,facebook,instagram,threads,pinterest
# Register authorization.removed at <BRIDGE_PUBLIC_URL>/api/tiktok/webhook.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202607
LINKEDIN_SCOPES=openid profile w_member_social
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Use sandbox while testing with Trial access; omit for production.
PINTEREST_ENVIRONMENT=sandbox
# Shared Google OAuth app; optional per-platform overrides below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# GOOGLE_BUSINESS_CLIENT_ID=
# GOOGLE_BUSINESS_CLIENT_SECRET=
# ES256 PKCS#8 private PEM (multiline secret or literal \n characters).
# Bluesky uses OAuth with public metadata and JWKS; no app passwords.
BLUESKY_PRIVATE_KEY=
# Bot API credentials. Register <BRIDGE_PUBLIC_URL>/api/telegram/webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=FindMeadowAppBot
TELEGRAM_WEBHOOK_SECRET=

# Channel chat messages, replies, and Twitch announcements
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
