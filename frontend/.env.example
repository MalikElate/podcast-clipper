VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Optional override of Meadow’s public PostHog token. Production hosts have a default.
# Local development and preview hosts never send usage events.
VITE_POSTHOG_ENABLED=true
VITE_POSTHOG_KEY=
VITE_BRIDGE_LOCAL_PREVIEW=false

# Optional webmaster verification tokens.
# Configure these in Cloudflare Workers Builds before rebuilding.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
